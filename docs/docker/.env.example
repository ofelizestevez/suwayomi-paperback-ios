# Copy this file to .env and fill in the credentials. Never commit .env.
# Create a tagged Tailscale auth key for the Docker sidecar.
TS_AUTHKEY=

# OAuth client used by Docktail to manage Tailscale Services.
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# Optional Suwayomi settings. Use the UID/GID that owns ./suwayomi-data.
PUID=1000
PGID=1000
TZ=Etc/UTC
